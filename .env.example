# Copia este archivo como .env.local y llena los valores.

# Contraseña del panel de administración (obligatoria en producción)
ADMIN_PASSWORD=cambia-esta-contraseña
# Cadena larga y aleatoria para firmar la sesión (ej. `openssl rand -hex 32`)
SESSION_SECRET=

# Base de datos. Local: archivo SQLite. Producción en Vercel: Turso (libsql://...)
DATABASE_URL=file:data/cafe.db
DATABASE_AUTH_TOKEN=

# URL pública del sitio (para links de seguimiento y regreso de Stripe)
SITE_URL=http://localhost:3000

# Zona horaria para reportes
NEXT_PUBLIC_TIMEZONE=America/Mexico_City

# Stripe (opcional). Sin estas llaves la tienda ofrece efectivo y WhatsApp.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
