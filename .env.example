# Copia este archivo como .env.local y llena los valores.

# Contraseña del panel de administración (obligatoria en producción)
ADMIN_PASSWORD=cambia-esta-contraseña
# Cadena larga y aleatoria para firmar la sesión (ej. `openssl rand -hex 32`)
SESSION_SECRET=

# Base de datos Postgres (Neon). Si la dejas vacía, en local se usa PGlite (data/pglite).
# En Vercel, la integración de Neon la llena sola.
DATABASE_URL=

# URL pública del sitio (para links de seguimiento y regreso de Stripe)
SITE_URL=http://localhost:3000

# Zona horaria para reportes
NEXT_PUBLIC_TIMEZONE=America/Mexico_City

# Stripe (opcional). Sin estas llaves la tienda ofrece efectivo y WhatsApp.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Programa de lealtad: envío del código para canjear la bebida gratis en línea (Twilio)
# TWILIO_FROM puede ser un número SMS (+1...) o WhatsApp ("whatsapp:+1...")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Avisos al celular con ntfy (el tema se configura en Admin → Ajustes).
# Solo si usas un servidor ntfy propio o un tema protegido con contraseña:
# NTFY_TOKEN=

# Envío por distancia con Google Maps (Geocoding API + Routes API).
# Crea la clave en Google Cloud y restríngela a esas dos APIs.
GOOGLE_MAPS_API_KEY=
